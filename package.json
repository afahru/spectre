{
  "name": "spectre",
  "version": "0.1.0",
  "description": "Spectre – M365 oversharing scan engine (Kiroween 2026)",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "tsc && node --test dist/scorer/__tests__/scorer.test.js dist/remediation/__tests__/remediation.test.js dist/attestation/__tests__/attestation.test.js dist/flagger/__tests__/sites.test.js dist/console/__tests__/api.test.js dist/store/__tests__/supersede.test.js dist/store/__tests__/backfill-supersede.test.js",
    "test:scorer": "tsc && node --test dist/scorer/__tests__/scorer.test.js",
    "seed": "ts-node src/seeder/index.ts",
    "verify": "ts-node src/seeder/verify.ts",
    "backfill:supersede": "ts-node src/store/backfill-supersede.ts",
    "attest": "node dist/attestation/run.js",
    "bot": "ts-node src/attestation/server.ts",
    "console": "ts-node src/console/server.ts",
    "web:build": "npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "@azure/identity": "4.4.1",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "better-sqlite3": "11.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "22.9.0",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
