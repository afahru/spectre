{
  "name": "spectre-console",
  "version": "0.1.0",
  "private": true,
  "description": "Spectre admin console (React + Fluent UI v9), served by the service from web/dist",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluentui/react-components": "9.54.0",
    "@fluentui/react-motion": "^9.6.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "@fluentui/react-motion": "$@fluentui/react-motion"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
